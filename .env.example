# Underwing Core: example configuration
# Settings are named UNDERWING_*. A .env from before the rename uses AEGIS_* for the
# same settings; those names still work, so an existing .env needs no changes.
# Copy to .env and fill in real values, or run ./setup.sh to generate secrets automatically.

NODE_ENV=production

# ── Core ─────────────────────────────────────────────────────────────────────

UNDERWING_PORT=8000
UNDERWING_HOST=0.0.0.0

# Public-facing URL used in claim notification links
UNDERWING_APP_URL=https://underwing.yourdomain.com

# SQLite database path (inside container: /data/underwing.db)
UNDERWING_DB_PATH=/data/underwing.db

# Local data directory for packet files
UNDERWING_DATA_DIR=/data

# Session secret — minimum 64 chars, must NOT contain "change-me" in production
UNDERWING_SECRET_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_64

# Field encryption key — minimum 64 hex chars (32 bytes) in production
UNDERWING_FIELD_ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32

# ── Notifications (configure via Settings UI after first login) ──────────────

UNDERWING_SMTP_HOST=
UNDERWING_SMTP_PORT=587
UNDERWING_SMTP_USER=
UNDERWING_SMTP_PASSWORD=
UNDERWING_SMTP_FROM=
UNDERWING_SMTP_SECURE=false

UNDERWING_TELEGRAM_BOT_TOKEN=
UNDERWING_TELEGRAM_CHAT_ID=

# ── S3-Compatible Storage — Dead Drop mode (configure via Settings UI) ────────

UNDERWING_S3_ENDPOINT=          # leave blank for AWS S3, set for MinIO/R2/B2
UNDERWING_S3_REGION=us-east-1
UNDERWING_S3_BUCKET=
UNDERWING_S3_ACCESS_KEY_ID=
UNDERWING_S3_SECRET_ACCESS_KEY=
UNDERWING_S3_PREFIX=underwing
# UNDERWING_S3_FORCE_PATH_STYLE=true    # enable for MinIO and path-style providers

# ── Worker ───────────────────────────────────────────────────────────────────

# How often the worker ticks (seconds). Default: 60
# UNDERWING_WORKER_INTERVAL_SECONDS=60
